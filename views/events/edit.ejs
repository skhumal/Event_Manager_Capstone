<section class="row justify-content-center">
    <div class="col-lg-8">

        <a href="/events" class="text-decoration-none mb-3 d-inline-block">
            &larr; Back to All Events
        </a>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h1 class="fw-bold mb-2">Edit Event</h1>
                <p class="text-secondary mb-4">
                    Update the details of your community event.
                </p>

                <% if (typeof error !== "undefined" && error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/events/<%= event.eventId %>/edit" method="POST">

                    <div class="mb-3">
                        <label for="title" class="form-label">
                            Event Title
                        </label>
                        <input
                            type="text"
                            class="form-control"
                            id="title"
                            name="title"
                            value="<%= event.title %>"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">
                            Description
                        </label>
                        <textarea
                            class="form-control"
                            id="description"
                            name="description"
                            rows="4"
                            required
                        ><%= event.description %></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="date" class="form-label">
                            Event Date
                        </label>
                        <input
                            type="date"
                            class="form-control"
                            id="date"
                            name="date"
                            value="<%= event.date.toISOString().split('T')[0] %>"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">
                            Location
                        </label>
                        <input
                            type="text"
                            class="form-control"
                            id="location"
                            name="location"
                            value="<%= event.location %>"
                            required
                        >
                    </div>

                    <div class="mb-4">
                        <label for="isActive" class="form-label">
                            Status
                        </label>
                        <select
                            class="form-select"
                            id="isActive"
                            name="isActive"
                        >
                            <option
                                value="true"
                                <%= event.isActive ? "selected" : "" %>
                            >
                                Active
                            </option>

                            <option
                                value="false"
                                <%= !event.isActive ? "selected" : "" %>
                            >
                                Inactive
                            </option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a href="/events" class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</section>
